<!--
***********************************************************************************************
CLRTest.CrossGen.targets

WARNING:  DO NOT MODIFY this file unless you are knowledgeable about MSBuild and have
          created a backup copy.  Incorrect changes to this file will make it
          impossible to load or build your projects from the command-line or the IDE.

This file contains the logic for providing Execution Script generation.

WARNING:   When setting properties based on their current state (for example:
           <Foo Condition="'$(Foo)'==''>Bar</Foo>).  Be very careful.  Another script generation
           target might be trying to do the same thing.  It's better to avoid this by instead setting a new property.

           Additionally, be careful with itemgroups.  Include will propagate outside of the target too!

***********************************************************************************************
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <BashScriptSnippetGen>$(BashScriptSnippetGen);GetCrossgenBashScript</BashScriptSnippetGen>
    <BatchScriptSnippetGen>$(BatchScriptSnippetGen);GetCrossgenBatchScript</BatchScriptSnippetGen>

    <!-- Crossgen2 testing is incompatible with the ilasm/ildasm round trip testing. -->
    <IlasmRoundTripIncompatible Condition="'$(AlwaysUseCrossGen2)' == 'true'">true</IlasmRoundTripIncompatible>
  </PropertyGroup>

  <!--
    This returns the portion of the execution script that generates the required lines to crossgen the test executable.

    Tests can opt out of ahead-of-time (AOT) compilation from crossgen / crossgen2 by setting this property in their project:

      <CrossGenTest>false</CrossGenTest>

    Tests can pass extra crossgen2 arguments only in composite mode by setting this property in their project:

      <CompositeCrossGen2TestExtraArguments>...</CompositeCrossGen2TestExtraArguments>

    Tests can still crossgen but skip the host R2RDump validation pass (e.g. wasm, where the host R2RDump
    tooling cannot yet inspect emitted components) by setting this property in their project:

      <CrossGenTestSkipR2RDump>true</CrossGenTestSkipR2RDump>

    Generated execution scripts can compile the test assemblies and System.Private.CoreLib into one
    composite image by setting the WholeProgramCompositeBuildMode environment variable.
  -->
  <Target Name="GetCrossgenBashScript">

    <Error Text="Setting both AlwaysUseCrossGen2 to true and CrossGenTest to false is non-sensical" Condition="'$(CrossGenTest)' == 'false' and '$(AlwaysUseCrossGen2)' == 'true'"/>

    <PropertyGroup>
      <CrossgenBashScript Condition="'$(CLRTestKind)' == 'BuildAndRun' and '$(R2RIncompatible)' == 'true'">
        <![CDATA[
if [ ! -z ${WholeProgramCompositeBuildMode+x} ]%3B then
  export RunCrossGen2=1
fi
if [ ! -z ${RunCrossGen2+x} ]%3B then
  echo SKIPPING EXECUTION BECAUSE the test is incompatible with ReadyToRun
  # Report the skip to a merged runner that launched this test out of process.
  if [ -n "${__TestOutOfProcessStatusFile:-}" ]%3B then
    echo "The test is incompatible with ReadyToRun." > "$__TestOutOfProcessStatusFile"
  fi
  exit 0
fi
        ]]>
      </CrossgenBashScript>
      <CrossgenBashScript Condition="'$(CLRTestKind)' == 'BuildAndRun' and '$(CrossGenTest)' != 'false' and '$(R2RIncompatible)' != 'true'">
        <![CDATA[

if [ "$(AlwaysUseCrossGen2)" == "true" ]; then
    export RunCrossGen2=1
    export CompositeBuildMode=1
fi

# The test runs from a copy of its directory in which compiled images replace the IL,
# so the IL in the test directory is never modified.
crossgen2OutputDirectoryName=readytorun
crossgen2Inputs="$PWD/*.dll"
if [ ! -z ${WholeProgramCompositeBuildMode+x} ]; then
    export RunCrossGen2=1
    export CompositeBuildMode=1
    # The composite contains CoreLib, so the test also runs on a copy of Core_Root that loads
    # the compiled CoreLib from this directory.
    crossgen2OutputDirectoryName=readytorun-wholeprogram
    crossgen2Inputs="$PWD/*.dll $CORE_ROOT/System.Private.CoreLib.dll"
    export R2RTestCoreRoot="$PWD/$crossgen2OutputDirectoryName"
    export CORE_LIBRARIES="$R2RTestCoreRoot"
fi
crossgen2OutputDirectory="$PWD/$crossgen2OutputDirectoryName"

# CrossGen2 Script
if [ ! -z ${RunCrossGen2+x} ]%3B then
  export TEST_READY_TO_RUN_MODE=1
  if [ "$(TargetOS)" == "wasi" ]; then
    # WASI loads R2R code from a single composite spliced into the host.
    export CompositeBuildMode=1
  fi
    TakeLock
    export DOTNET_CROSSGEN2_CACHE="${DOTNET_CROSSGEN2_CACHE:-true}"
    __Crossgen2TestNoCache=
    if [ -n "$ExtraCrossGen2Args$(CrossGen2TestExtraArguments)$(CompositeCrossGen2TestExtraArguments)" ] || [ ! -z ${CrossGen2SynthesizePgo+x} ]; then
      __Crossgen2TestNoCache=--no-cache
    fi
    rm -rf "$crossgen2OutputDirectory"
    mkdir "$crossgen2OutputDirectory"
    for testFile in *%3B do
      case "$testFile" in
        # Copied wrappers and markers would be discovered as additional tests.
        readytorun|readytorun-wholeprogram|lock|Reports|*.sh|*.cmd|*.MergedTestAssembly|*.MergedTestAssemblyForStress|*.StandaloneTestRunner|*.OutOfProcessTest|*.HasOutOfProcessTests|*.log)
          %3B%3B
        *)
          cp -R "$testFile" "$crossgen2OutputDirectory/"
          %3B%3B
      esac
    done
      if [ ! -z ${WholeProgramCompositeBuildMode+x} ]%3B then
        # Framework assemblies take precedence over same-named test files, as they do when
        # the runtime resolves them from CORE_LIBRARIES.
        cp "$CORE_ROOT"/*.dll "$crossgen2OutputDirectory/"
      fi

      if [ ! -z ${CompositeBuildMode+x} ]%3B then
        if [ "$(CrossGen2OutputFormat)" != "wasm" ]; then
          # HACK: copy native shared shim libraries. Not needed on Windows.
          for nativeLibrary in "$CORE_ROOT"/lib*.so "$CORE_ROOT"/lib*.dylib; do
            if [ -f "$nativeLibrary" ]; then
              cp "$nativeLibrary" "$crossgen2OutputDirectory/"
            fi
          done
        fi

        ExtraCrossGen2Args+=" --composite"
        ExtraCrossGen2Args+=" $(CompositeCrossGen2TestExtraArguments)"
      fi

      ExtraCrossGen2Args+=" $(CrossGen2TestExtraArguments)"

      if [ ! -z ${LargeVersionBubble+x} ]%3B then
          ExtraCrossGen2Args+=" --inputbubble"
      fi

      # NOTE: CrossGen2TestCheckPdb not implemented in this version (no PDBs on *nix)

      __cg2ExitCode=0
      __r2rDumpExitCode=0

      # Tests run locally need __TestDotNetCmd (set by runtest.py) or a compatible dotnet runtime in the path.
      if [ ! -z ${__TestDotNetCmd+x} ] %3B then
          __DotNet="$__TestDotNetCmd"
      else
          __DotNet=dotnet
      fi

      RunCrossgen2OnFiles() {
        date +%H:%M:%S
        __OutputFile=$1
        __OutputFileFinal=$2

        __ResponseFile="$__OutputFile.rsp"
        rm "$__ResponseFile" 2>/dev/null

        __R2RDumpCommand="$_DebuggerFullPath $__DotNet $CORE_ROOT/R2RDump/R2RDump.dll"

        __Command="$_DebuggerFullPath $CORE_ROOT/crossgen2/crossgen2"
        __Command+=" @$__ResponseFile"
        __Command+=" $ExtraCrossGen2Args"
        if [ -n "$(CrossGen2OutputFormat)" ]; then
            __Command+=" -f $(CrossGen2OutputFormat)"
        fi

        # Expand glob or multiple filenames into array
        __InputFiles=($3)
        for dllFile in "${__InputFiles[@]}"; do
          echo "$dllFile" >> "$__ResponseFile"
        done

        echo -o:"$__OutputFile" >> "$__ResponseFile"
        echo -O >> "$__ResponseFile"
        echo --targetarch:$(TargetArchitecture) >> "$__ResponseFile"
        echo --targetos:$(TargetOS) >> "$__ResponseFile"
        # Layout verification loads types early, which hides missing signature preparation under GC stress.
        if [ -z "$DOTNET_GCStress" ] || [ "$DOTNET_GCStress" == "0" ]; then
            echo --verify-type-and-field-layout >> "$__ResponseFile"
        fi
        echo --method-layout:random >> "$__ResponseFile"
        if [ "$(CrossGen2OutputFormat)" == "wasm" ]; then
            echo --verify-gc-mode-transitions >> "$__ResponseFile"
        fi
        if [ ! -z ${CrossGen2SynthesizePgo+x} ]%3B then
            echo --synthesize-random-mibc >> "$__ResponseFile"
            if [ "$(TargetArchitecture)" != "wasm" ]; then
                echo --embed-pgo-data >> "$__ResponseFile"
            fi
        fi
        if [ ! -z ${HotColdSplitting+x} ]%3B then
            echo --hot-cold-splitting >> "$__ResponseFile"
        fi

        # HACK: Suppress the globbing of the references and filenames causing empty lines in the response file
        set -o noglob

        echo -r:$CORE_ROOT/System.*.dll >> "$__ResponseFile"
        echo -r:$CORE_ROOT/Microsoft.*.dll >> "$__ResponseFile"
        echo -r:$CORE_ROOT/xunit.*.dll >> "$__ResponseFile"
        echo -r:$CORE_ROOT/mscorlib.dll >> "$__ResponseFile"
        echo -r:$CORE_ROOT/netstandard.dll >> "$__ResponseFile"

        # HACK: Re-enable globbing
        set +o noglob

        echo "Response file: $__ResponseFile"
        cat "$__ResponseFile"

        # Suppress some DOTNET variables for the duration of Crossgen2 execution
        export -n DOTNET_GCName DOTNET_GCStress DOTNET_HeapVerify DOTNET_ReadyToRun DOTNET_GCHeapAffinitizeRanges
        # FIXME: Remove this?
        # work around problems in 6.0 OSR
        export -n DOTNET_TC_OnStackReplacement DOTNET_TC_PartialCompilation

        echo "Running CrossGen2: $__Command"
        if [ -n "$_DebuggerFullPath" ]; then
          $__Command
        else
          __CacheExtraArguments="$ExtraCrossGen2Args"
          if [ -n "$(CrossGen2OutputFormat)" ]; then
            __CacheExtraArguments+=" -f $(CrossGen2OutputFormat)"
          fi
          "$CORE_ROOT/crossgen2-test/crossgen2-test" --core-root "$CORE_ROOT" --out "$__OutputFile" --rsp "$__ResponseFile" $__Crossgen2TestNoCache -- $__CacheExtraArguments
        fi
        __cg2ExitCode=$?

        __linkExitCode=0
        if [ "$(CrossGen2OutputFormat)" == "macho" ]; then
            echo "Linking: $(basename "$__OutputFile") -> $(basename "$__OutputFileFinal")"
            echo  clang -dynamiclib -o "$__OutputFileFinal" "$__OutputFile" -install_name "@rpath/`basename "$__OutputFileFinal"`" -Wl,-dead_strip
            clang -dynamiclib -o "$__OutputFileFinal" "$__OutputFile" -install_name "@rpath/`basename "$__OutputFileFinal"`" -Wl,-dead_strip
            __linkExitCode=$?
        fi

        if [ $__cg2ExitCode -eq 0 ] && [ "$(CrossGenTestSkipR2RDump)" != "true" ]; then
          if [ "$(CrossGen2OutputFormat)" == "wasm" ] && [ ! -z ${CompositeBuildMode+x} ]; then
            # The composite WASM output is a manifest, so validate each emitted R2R component.
            for dllFile in "${__InputFiles[@]}"; do
              __R2RDumpInput="$crossgen2OutputDirectory/${dllFile##*/}"
              __R2RDumpInput="${__R2RDumpInput%.dll}.wasm"
              __R2RDumpOutput="${__R2RDumpInput}.r2rdump"
              echo "Running R2RDump: $__R2RDumpCommand --header --sc --in $__R2RDumpInput --out $__R2RDumpOutput --val --rp $CORE_ROOT"
              $__R2RDumpCommand --header --sc --in "$__R2RDumpInput" --out "$__R2RDumpOutput" --val --rp "$CORE_ROOT"
              __r2rDumpExitCode=$?
              if [ $__r2rDumpExitCode -ne 0 ]; then
                break
              fi
            done
          else
            echo "Running R2RDump: $__R2RDumpCommand --header --sc --in $__OutputFileFinal --out $__OutputFileFinal.r2rdump --val --rp $CORE_ROOT"
            $__R2RDumpCommand --header --sc --in "$__OutputFileFinal" --out "$__OutputFileFinal.r2rdump" --val --rp "$CORE_ROOT"
            __r2rDumpExitCode=$?
          fi
        fi

        export DOTNET_GCName DOTNET_GCStress DOTNET_HeapVerify DOTNET_ReadyToRun DOTNET_GCHeapAffinitizeRanges
        export DOTNET_TC_OnStackReplacement DOTNET_TC_PartialCompilation
        date +%H:%M:%S
      }

      if [ ! -z ${CompositeBuildMode+x} ]%3B then
          shopt -s nullglob
          __CompositeExt=".dll"
          __CompositeExtFinal=".dll"
          if [ "$(CrossGen2OutputFormat)" == "macho" ]; then
              __CompositeExt=".o"
              __CompositeExtFinal=".dylib"
          elif [ "$(CrossGen2OutputFormat)" == "wasm" ]; then
              __CompositeExt=".wasm"
              __CompositeExtFinal=".wasm"
          fi
          RunCrossgen2OnFiles "$crossgen2OutputDirectory/composite-r2r${__CompositeExt}" "$crossgen2OutputDirectory/composite-r2r${__CompositeExtFinal}" "$crossgen2Inputs"
      else
          ExtraCrossGen2Args+=" -r:$PWD/*.dll"
          for dllFile in "$PWD"/*.dll
          do
            echo $dllFile
            bareFileName="${dllFile##*/}"
            if [ "$(CrossGen2OutputFormat)" == "wasm" ]; then
                bareFileName="${bareFileName%.dll}.wasm"
            fi
            RunCrossgen2OnFiles "$crossgen2OutputDirectory/$bareFileName" "$crossgen2OutputDirectory/$bareFileName" "$dllFile"
            if [ $__cg2ExitCode -ne 0 ]; then
              break
            fi
          done
      fi

      if [ "$(TargetOS)" == "wasi" ] && [ $__cg2ExitCode -eq 0 ] && [ $__r2rDumpExitCode -eq 0 ]; then
        (
          # Like crossgen2, the composer must not run under the test's runtime configuration.
          unset DOTNET_GCName DOTNET_GCStress DOTNET_HeapVerify DOTNET_ReadyToRun DOTNET_GCHeapAffinitizeRanges
          unset DOTNET_TC_OnStackReplacement DOTNET_TC_PartialCompilation
          mkdir -p "$crossgen2OutputDirectory/wasi-r2r/comp" || exit 1
          # Use the staged test-specific host so the composer excludes it from the stub scan.
          __WasiR2RComponent="$CORE_ROOT/corerun"
          if [ -f "$PWD/corerun.wasm" ]; then
            __WasiR2RComponent="$crossgen2OutputDirectory/corerun.wasm"
          fi
          "$__DotNet" msbuild "$CORE_ROOT/wasi-r2r/WasiR2RComposer.proj" -nologo -t:Compose "/p:CompositePath=$crossgen2OutputDirectory/composite-r2r.wasm" "/p:ComponentPath=$__WasiR2RComponent" "/p:OutputDirectory=$crossgen2OutputDirectory/wasi-r2r/work" "/p:OutputPath=$crossgen2OutputDirectory/wasi-r2r/corerun-composite.wasm" "/p:WasmToolsPath=%24(command -v wasm-tools)" "/p:WasmMergePath=%24(command -v wasm-merge)" "/p:WasmOptPath=%24(command -v wasm-opt)" "/p:StubOutputDirectory=$crossgen2OutputDirectory/wasi-r2r/comp" "/p:ComponentStubsDirectory=$crossgen2OutputDirectory"
        )
        __linkExitCode=$?
        if [ $__linkExitCode -ne 0 ]; then
          rm -f "$crossgen2OutputDirectory/wasi-r2r/corerun-composite.wasm"
        fi
      fi

      if [ $__cg2ExitCode -ne 0 ]; then
        echo Crossgen2 failed with exitcode: $__cg2ExitCode
        ReleaseLock
        exit 1
      fi
      if [ $__r2rDumpExitCode -ne 0 ]; then
        echo R2RDump failed with exitcode: $__r2rDumpExitCode
        ReleaseLock
        exit 1
      fi
      if [ $__linkExitCode -ne 0 ]; then
        echo "Linking failed with exitcode: $__linkExitCode"
        ReleaseLock
        exit 1
      fi
      if [ -f "$crossgen2OutputDirectoryName/$ExePath" ]%3B then
        ExePath="$crossgen2OutputDirectoryName/$ExePath"
      fi
      # Merged runners locate out-of-process tests relative to the original test directory.
      export __TestOutOfProcessBaseDirectory="$PWD/"
    ReleaseLock
fi
        ]]>
      </CrossgenBashScript>

      <CLRTestBashPreCommands>$(CLRTestBashPreCommands);$(CrossgenBashScript)</CLRTestBashPreCommands>
    </PropertyGroup>
  </Target>

  <Target Name="GetCrossgenBatchScript">
    <PropertyGroup>
      <CrossgenBatchScript Condition="'$(CLRTestKind)' == 'BuildAndRun' and '$(R2RIncompatible)' == 'true'">
        <![CDATA[
IF DEFINED WholeProgramCompositeBuildMode (
  SET RunCrossGen2=1
)
IF NOT "%RunCrossGen2%"=="" (
  ECHO SKIPPING EXECUTION BECAUSE the test is incompatible with ReadyToRun
  popd
  Exit /b 0
)
        ]]>
      </CrossgenBatchScript>
      <CrossgenBatchScript Condition="'$(CLRTestKind)' == 'BuildAndRun' and '$(CrossGenTest)' != 'false' and '$(R2RIncompatible)' != 'true'">
        <![CDATA[

if /i "$(AlwaysUseCrossGen2)" == "true" (
    set RunCrossGen2=1
    set CompositeBuildMode=1
)

REM The test runs from a copy of its directory in which compiled images replace the IL,
REM so the IL in the test directory is never modified.
set crossgen2OutputDirectoryName=readytorun
set crossgen2Inputs="!scriptPath!*.dll"
if defined WholeProgramCompositeBuildMode (
    set RunCrossGen2=1
    set CompositeBuildMode=1
    REM The composite contains CoreLib, so the test also runs on a copy of Core_Root that loads
    REM the compiled CoreLib from this directory.
    set crossgen2OutputDirectoryName=readytorun-wholeprogram
    set crossgen2Inputs="!scriptPath!*.dll" "!CORE_ROOT!\System.Private.CoreLib.dll"
)
set "crossgen2OutputDirectory=!scriptPath!!crossgen2OutputDirectoryName!"
if defined WholeProgramCompositeBuildMode (
    set "R2RTestCoreRoot=!crossgen2OutputDirectory!"
    set "CORE_LIBRARIES=!R2RTestCoreRoot!"
)

REM CrossGen2 Script
if defined RunCrossGen2 (
    set TEST_READY_TO_RUN_MODE=1
    set __Crossgen2TestNoCache=
    if defined ExtraCrossGen2Args set __Crossgen2TestNoCache=--no-cache
    if not "$(CrossGen2TestExtraArguments)$(CompositeCrossGen2TestExtraArguments)"=="" set __Crossgen2TestNoCache=--no-cache
    if defined CrossGen2SynthesizePgo set __Crossgen2TestNoCache=--no-cache
    set ExtraCrossGen2Args=!ExtraCrossGen2Args! $(CrossGen2TestExtraArguments)
    set CrossGen2TestCheckPdb=$(CrossGen2TestCheckPdb)
    set __CreatePdb=$(__CreatePdb)

    if defined LargeVersionBubble ( set ExtraCrossGen2Args=!ExtraCrossGen2Args! --inputbubble)
    if defined CrossGen2TestCheckPdb ( set __CreatePdb=1)

    set CrossGen2Status=0
    set R2RDumpStatus=0
    call :TakeLock
    if not defined DOTNET_CROSSGEN2_CACHE set DOTNET_CROSSGEN2_CACHE=true
    if exist "!crossgen2OutputDirectory!" rd /s /q "!crossgen2OutputDirectory!"
    REM Copied wrappers and markers would be discovered as additional tests.
    robocopy "!scriptPath:~0,-1!" "!crossgen2OutputDirectory!" /E /NFL /NDL /NJH /NJS /NP /XD "!scriptPath!readytorun" "!scriptPath!readytorun-wholeprogram" "!scriptPath!lock" "!scriptPath!Reports" /XF *.sh *.cmd *.MergedTestAssembly *.MergedTestAssemblyForStress *.StandaloneTestRunner *.OutOfProcessTest *.HasOutOfProcessTests *.log >nul
    if !ERRORLEVEL! GEQ 8 (
        echo Failed to copy the test directory to !crossgen2OutputDirectory!
        set CrossGen2Status=1
        goto :DoneCrossgen2Operations
    )
    REM Framework assemblies take precedence over same-named test files, as they do when
    REM the runtime resolves them from CORE_LIBRARIES.
    if defined WholeProgramCompositeBuildMode copy /y "!CORE_ROOT!\*.dll" "!crossgen2OutputDirectory!\" >nul

    if defined CompositeBuildMode (
        set ExtraCrossGen2Args=!ExtraCrossGen2Args! --composite
        set ExtraCrossGen2Args=!ExtraCrossGen2Args! $(CompositeCrossGen2TestExtraArguments)
        if "$(CrossGen2OutputFormat)"=="wasm" (
            set __OutputFile=!crossgen2OutputDirectory!\composite-r2r.wasm
        ) else (
            set __OutputFile=!crossgen2OutputDirectory!\composite-r2r.dll
        )
        set __PdbFile=!crossgen2OutputDirectory!\composite-r2r.ni.pdb
        rem In composite mode, treat all dll's in the test folder as rooting inputs
        set __InputFile=!crossgen2Inputs!
        call :CompileOneFileCrossgen2
        IF NOT !CrossGen2Status!==0 goto :DoneCrossgen2Operations
    ) else (
        set ExtraCrossGen2Args=!ExtraCrossGen2Args! -r:!scriptPath!*.dll
        for %%I in ("!scriptPath!*.dll") do (
            if "$(CrossGen2OutputFormat)"=="wasm" (
                set __OutputFile=!crossgen2OutputDirectory!\%%~nI.wasm
            ) else (
                set __OutputFile=!crossgen2OutputDirectory!\%%~nI.dll
            )
            set __PdbFile=!crossgen2OutputDirectory!\%%~nI.ni.pdb
            set __InputFile="%%I"
            call :CompileOneFileCrossgen2
            IF NOT !CrossGen2Status!==0 (
              IF NOT !CrossGen2Status!==2 goto :DoneCrossgen2Operations
            )
            rem Normalize return code 2, no valid input files, to success code
            set CrossGen2Status=0
        )
    )

    goto :DoneCrossgen2Operations
:CompileOneFileCrossgen2
    echo %time%
    set __ResponseFile=!__OutputFile!.rsp
    del /Q !__ResponseFile! 2>nul

    REM Tests run locally need __TestDotNetCmd (set by runtest.py) or a compatible 5.0 dotnet runtime in the path
    if defined __TestDotNetCmd (
        set __DotNet="!__TestDotNetCmd!"
    ) else (
        set __DotNet="dotnet"
    )
    set __R2RDumpCommand=!_DebuggerFullPath! !__DotNet! "!CORE_ROOT!\r2rdump\r2rdump.dll"

    set __Command=!_DebuggerFullPath! "!CORE_ROOT!\crossgen2\crossgen2.exe"
    set __Command=!__Command! @"!__ResponseFile!"
    set __Command=!__Command! !ExtraCrossGen2Args!

    for %%J in (!__InputFile!) do echo %%~fJ>>!__ResponseFile!
    echo -O>>!__ResponseFile!
    echo -o:!__OutputFile!>>!__ResponseFile!
    echo --targetarch:$(TargetArchitecture)>>!__ResponseFile!
    echo --targetos:$(TargetOS)>>!__ResponseFile!
    rem Layout verification loads types early, which hides missing signature preparation under GC stress.
    set __VerifyLayout=1
    if defined DOTNET_GCStress if not "!DOTNET_GCStress!"=="0" set __VerifyLayout=
    if defined __VerifyLayout echo --verify-type-and-field-layout>>!__ResponseFile!
    echo --method-layout:random>>!__ResponseFile!
    if "$(CrossGen2OutputFormat)"=="wasm" (
        echo --verify-gc-mode-transitions>>!__ResponseFile!
    )
    if not "$(CrossGen2OutputFormat)"=="" (
        echo -f:$(CrossGen2OutputFormat)>>!__ResponseFile!
    )
    if defined CrossGen2SynthesizePgo (
        echo --synthesize-random-mibc>>!__ResponseFile!
        if not "$(TargetArchitecture)"=="wasm" (
            echo --embed-pgo-data>>!__ResponseFile!
        )
    )
    if defined HotColdSplitting (
        echo --hot-cold-splitting>>!__ResponseFile!
    )
    echo -r:!CORE_ROOT!\System.*.dll>>!__ResponseFile!
    echo -r:!CORE_ROOT!\Microsoft.*.dll>>!__ResponseFile!
    echo -r:!CORE_ROOT!\xunit.*.dll>>!__ResponseFile!
    echo -r:!CORE_ROOT!\mscorlib.dll>>!__ResponseFile!
    echo -r:!CORE_ROOT!\netstandard.dll>>!__ResponseFile!

    if defined __CreatePdb (
        echo --pdb>>!__ResponseFile!
    )

    echo Response file: !__ResponseFile!
    type !__ResponseFile!

    REM Suppress some DOTNET and COMPlus variables for the duration of Crossgen2 execution
    setlocal
    set "DOTNET_GCName="
    set "DOTNET_GCStress="
    set "DOTNET_HeapVerify="
    set "DOTNET_ReadyToRun="
    set "DOTNET_GCHeapAffinitizeRanges="

    REM FIXME: remove this?
    REM work around problems in 6.0 OSR
    set "DOTNET_TC_OnStackReplacement="
    set "DOTNET_TC_PartialCompilation="

    echo "Running CrossGen2: !__Command!"
    if defined _DebuggerFullPath (
        call !__Command!
    ) else (
        call "!CORE_ROOT!\crossgen2-test\crossgen2-test.exe" --core-root "!CORE_ROOT!" --out "!__OutputFile!" --rsp "!__ResponseFile!" !__Crossgen2TestNoCache! -- !ExtraCrossGen2Args!
    )

    set CrossGen2Status=!ERRORLEVEL!

    IF NOT !CrossGen2Status!==0 goto :DoneR2RDumpOperations

    if /i "$(CrossGenTestSkipR2RDump)"=="true" goto :DoneR2RDumpOperations

    set __R2RDumpInput=!__OutputFile!
    if "$(CrossGen2OutputFormat)"=="wasm" (
        REM The composite WASM output is a manifest, so validate each emitted R2R component.
        if defined CompositeBuildMode set __R2RDumpInput=
    )

    if defined __R2RDumpInput (
        set __R2RDumpArguments=--header --sc --in "!__R2RDumpInput!" --out "!__R2RDumpInput!.r2rdump" --val --rp "!CORE_ROOT!"
        echo "Running R2RDump: !__R2RDumpCommand! !__R2RDumpArguments!"
        call !__R2RDumpCommand! !__R2RDumpArguments!
        set R2RDumpStatus=!ERRORLEVEL!
    ) else (
        for %%I in (!crossgen2Inputs!) do (
            set __R2RDumpInput=!crossgen2OutputDirectory!\%%~nI.wasm
            set __R2RDumpArguments=--header --sc --in "!__R2RDumpInput!" --out "!__R2RDumpInput!.r2rdump" --val --rp "!CORE_ROOT!"
            echo "Running R2RDump: !__R2RDumpCommand! !__R2RDumpArguments!"
            call !__R2RDumpCommand! !__R2RDumpArguments!
            set R2RDumpStatus=!ERRORLEVEL!
            if not !R2RDumpStatus!==0 goto :DoneR2RDumpOperations
        )
    )

:DoneR2RDumpOperations
    endlocal & set "R2RDumpStatus=%R2RDumpStatus%" &set "CrossGen2Status=%CrossGen2Status%"

    echo %time%

    if !CrossGen2Status!==0 (
        if defined CrossGen2TestCheckPdb (
            set __CheckPdbCommand=!__DotNet!
            set __CheckPdbCommand=!__CheckPdbCommand! "!CORE_ROOT!\PdbChecker\PdbChecker.dll"
            set __CheckPdbCommand=!__CheckPdbCommand! !__PdbFile! --image !__OutputFile! @(CheckPdbSymbol->'%22%(Identity)%22', ' ')
            echo "!__CheckPdbCommand!"
            call !__CheckPdbCommand!
            if not !ERRORLEVEL!==0 (
                echo PDB check failed for file !__PdbFile! >2
                set CrossGen2Status=42
            )
        )
    )

    Exit /b 0

:DoneCrossgen2Operations
    call :ReleaseLock
    IF NOT !CrossGen2Status!==0 (
        ECHO Crossgen2 failed with exitcode - !CrossGen2Status!
        Exit /b 1
    )
    IF NOT !R2RDumpStatus!==0 (
        ECHO R2RDump failed with exitcode - !R2RDumpStatus!
        Exit /b 1
    )
    if exist "!crossgen2OutputDirectoryName!\!ExePath!" set "ExePath=!crossgen2OutputDirectoryName!\!ExePath!"
    REM Merged runners locate out-of-process tests relative to the original test directory.
    set "__TestOutOfProcessBaseDirectory=!scriptPath!"
)
        ]]>
      </CrossgenBatchScript>

      <CLRTestBatchPreCommands>$(CLRTestBatchPreCommands);$(CrossgenBatchScript)</CLRTestBatchPreCommands>
    </PropertyGroup>
  </Target>
</Project>
